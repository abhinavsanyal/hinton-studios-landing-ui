---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Call Booked — Hinton Studios" 
  description="Your discovery call with Hinton Studios has been scheduled. Check your email for the calendar invite and meeting details."
  keywords="hinton studios call booked, ai filmmaking meeting confirmed, discovery call scheduled"
  fireConversion={true}
>
  <!-- Call Booking Conversion Event -->
  <script is:inline>
    if (typeof gtag === 'function') {
      gtag('event', 'conversion', {
        'send_to': 'AW-16849162870/call_booking',
        'event_category': 'engagement',
        'event_label': 'discovery_call_booked'
      });
    }
  </script>

  <main class="min-h-screen pt-32 pb-24 bg-surface relative overflow-hidden flex flex-col items-center justify-center">
    <!-- Grid Background -->
    <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:4rem_4rem] pointer-events-none"></div>
    
    <!-- Ambient Glow -->
    <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 60% 40% at 50% 40%, rgba(144, 147, 255, 0.1) 0%, transparent 70%);"></div>

    <div class="max-w-3xl mx-auto px-6 md:px-12 relative z-10 text-center">
      
      <!-- Success Icon -->
      <div class="mb-12" data-reveal>
        <div class="relative inline-flex items-center justify-center">
          <div class="absolute w-32 h-32 bg-tertiary/10 rounded-full animate-pulse-soft"></div>
          <div class="absolute w-24 h-24 bg-tertiary/20 rounded-full"></div>
          <div class="relative w-20 h-20 bg-tertiary/30 rounded-full flex items-center justify-center border border-tertiary/50">
            <span class="material-symbols-outlined text-4xl text-tertiary">videocam</span>
          </div>
        </div>
      </div>

      <!-- Status Header -->
      <div data-reveal style="--reveal-delay: 80ms">
        <span class="font-label text-[10px] tracking-[0.4em] uppercase text-tertiary mb-6 block font-bold flex items-center justify-center gap-4">
          <div class="w-1.5 h-1.5 bg-tertiary rounded-full animate-pulse-soft"></div>
          CALL SCHEDULED
          <div class="w-1.5 h-1.5 bg-tertiary rounded-full animate-pulse-soft"></div>
        </span>
        <h1 class="font-headline text-5xl md:text-7xl font-bold uppercase tracking-tighter text-white mb-8 leading-[0.85]">
          YOU'RE<br /><span class="text-tertiary italic">BOOKED.</span>
        </h1>
      </div>

      <!-- Confirmation Message -->
      <div class="max-w-xl mx-auto" data-reveal style="--reveal-delay: 160ms">
        <p class="font-body text-lg text-on-surface-variant leading-relaxed mb-8">
          Your discovery call has been confirmed. Check your email for the <span class="text-white font-bold">calendar invite</span> and meeting link.
        </p>
        <div class="h-px w-24 bg-tertiary mx-auto mb-8"></div>
        <p class="font-body text-sm text-outline leading-relaxed">
          We'll send you a reminder before the call. In the meantime, feel free to explore our work or prepare any questions you'd like to discuss.
        </p>
      </div>

      <!-- Status Grid -->
      <div class="grid grid-cols-3 gap-4 mt-16 mb-16 max-w-lg mx-auto" data-reveal style="--reveal-delay: 240ms">
        <div class="border border-outline-variant/20 p-4 bg-black/40 backdrop-blur">
          <div class="flex items-center justify-center gap-2 mb-2">
            <span class="w-2 h-2 bg-tertiary rounded-full animate-pulse-soft"></span>
            <span class="font-label text-[8px] tracking-[0.3em] uppercase text-tertiary">STATUS</span>
          </div>
          <p class="font-headline text-sm font-bold text-white uppercase tracking-tight">Confirmed</p>
        </div>
        <div class="border border-outline-variant/20 p-4 bg-black/40 backdrop-blur">
          <div class="flex items-center justify-center gap-2 mb-2">
            <span class="w-2 h-2 bg-tertiary rounded-full"></span>
            <span class="font-label text-[8px] tracking-[0.3em] uppercase text-tertiary">INVITE</span>
          </div>
          <p class="font-headline text-sm font-bold text-white uppercase tracking-tight">Sent</p>
        </div>
        <div class="border border-outline-variant/20 p-4 bg-black/40 backdrop-blur">
          <div class="flex items-center justify-center gap-2 mb-2">
            <span class="w-2 h-2 bg-tertiary rounded-full"></span>
            <span class="font-label text-[8px] tracking-[0.3em] uppercase text-tertiary">CALENDAR</span>
          </div>
          <p class="font-headline text-sm font-bold text-white uppercase tracking-tight">Synced</p>
        </div>
      </div>

      <!-- Navigation Links -->
      <div class="flex flex-col sm:flex-row justify-center items-center gap-6 mt-8" data-reveal style="--reveal-delay: 320ms">
        <a href="/" class="group flex items-center gap-3 font-headline text-xs font-bold tracking-[0.3em] uppercase text-black bg-white px-8 py-4 hover:bg-tertiary transition-colors duration-500">
          <span class="material-symbols-outlined text-lg group-hover:-translate-x-1 transition-transform">arrow_back</span>
          RETURN HOME
        </a>
        <a href="/work" class="group flex items-center gap-3 font-headline text-xs font-bold tracking-[0.3em] uppercase text-primary border border-primary/30 px-8 py-4 hover:bg-primary hover:text-black transition-all duration-500">
          EXPLORE WORK
          <span class="material-symbols-outlined text-lg group-hover:translate-x-1 transition-transform">arrow_forward</span>
        </a>
      </div>

      <!-- Social Links -->
      <div class="mt-20 pt-8 border-t border-outline-variant/10" data-reveal style="--reveal-delay: 400ms">
        <p class="font-label text-[10px] uppercase tracking-[0.3em] text-outline mb-6">Follow The Signal</p>
        <div class="flex justify-center gap-6">
          <a class="text-[#767575] hover:text-[#9093ff] transition-colors" aria-label="Instagram" href="https://www.instagram.com/hinton_studios/" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
          <a class="text-[#767575] hover:text-[#9093ff] transition-colors" aria-label="YouTube" href="https://youtube.com/@hintonpictures" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>
