---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Start Your AI Film Project — Get a Quote | Hinton Studios" 
  description="Ready to create an AI spec ad, AI commercial, or AI short film? Submit your project details and our team will engineer your vision using generative AI filmmaking."
  keywords="hire ai filmmaking studio, ai film production quote, start ai video project, ai spec ad quote, ai commercial production quote, ai content creation inquiry"
>
  <main class="min-h-screen pt-32 pb-24 bg-surface relative overflow-hidden">
    <!-- Grid Background -->
    <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:4rem_4rem] pointer-events-none"></div>

    <div class="max-w-4xl mx-auto px-6 md:px-12 relative z-10">
      
      <!-- Header -->
      <header class="mb-16" data-reveal>
        <span class="font-label text-[10px] tracking-[0.4em] uppercase text-tertiary mb-6 block font-bold flex items-center gap-4">
          <div class="w-1.5 h-1.5 bg-tertiary rounded-full animate-pulse-soft"></div>
          SECURE CONNECTION ESTABLISHED
        </span>
        <h1 class="font-headline text-5xl md:text-7xl font-bold uppercase tracking-tighter text-white mb-6">INITIATE PHASE ONE</h1>
        <p class="font-body text-outline-variant leading-relaxed max-w-xl">
          Enter your parameters below. Our hybrid production engine requires precise inputs to calculate feasibility, timeline, and resource allocation.
        </p>
      </header>

      <!-- Multi-stage Form Container (React/Island placeholder) -->
      <div id="discovery-form-root" class="bg-black/60 border border-outline-variant/20 p-8 md:p-12 shadow-2xl backdrop-blur-xl" data-reveal style="--reveal-delay: 100ms">
        
        <!-- UI Stub for Form -->
        <div class="flex justify-between items-center border-b border-outline-variant/20 pb-6 mb-8">
          <div class="font-label text-[10px] tracking-widest text-[#c6c6c6] uppercase">STAGE_01 // VISION</div>
          <div class="font-label text-[10px] tracking-widest text-primary uppercase">01 / 05</div>
        </div>

        <form class="space-y-8" id="stub-discovery-form">
          <p class="font-headline text-2xl font-bold text-white uppercase tracking-tighter mb-8">What are we building?</p>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <label class="border border-outline-variant/30 hover:border-tertiary p-6 cursor-pointer hover:bg-surface-container-low transition-all group flex items-center gap-4">
              <input type="radio" name="vision" value="Brand Commercial" class="accent-tertiary w-4 h-4 bg-transparent border-outline-variant/50" />
              <span class="font-headline tracking-widest uppercase text-sm group-hover:text-tertiary">Brand Commercial / TVC</span>
            </label>
            <label class="border border-outline-variant/30 hover:border-tertiary p-6 cursor-pointer hover:bg-surface-container-low transition-all group flex items-center gap-4">
              <input type="radio" name="vision" value="Social Campaign" class="accent-tertiary w-4 h-4 bg-transparent border-outline-variant/50" />
              <span class="font-headline tracking-widest uppercase text-sm group-hover:text-tertiary">Social Campaign</span>
            </label>
            <label class="border border-outline-variant/30 hover:border-tertiary p-6 cursor-pointer hover:bg-surface-container-low transition-all group flex items-center gap-4">
              <input type="radio" name="vision" value="Music Video" class="accent-tertiary w-4 h-4 bg-transparent border-outline-variant/50" />
              <span class="font-headline tracking-widest uppercase text-sm group-hover:text-tertiary">Music Video</span>
            </label>
            <label class="border border-outline-variant/30 hover:border-tertiary p-6 cursor-pointer hover:bg-surface-container-low transition-all group flex items-center gap-4">
              <input type="radio" name="vision" value="Short Film" class="accent-tertiary w-4 h-4 bg-transparent border-outline-variant/50" />
              <span class="font-headline tracking-widest uppercase text-sm group-hover:text-tertiary">Short Film</span>
            </label>
          </div>

          <div class="flex justify-end pt-8">
             <button type="button" class="group flex items-center gap-4 font-headline text-sm tracking-[0.3em] uppercase font-bold text-black bg-white px-8 py-4 hover:bg-tertiary transition-colors">
                PROCEED
                <span class="material-symbols-outlined text-lg group-hover:translate-x-1 transition-transform">arrow_forward</span>
             </button>
          </div>
        </form>

        <div class="mt-8 font-label text-[8px] text-outline-variant/50 uppercase tracking-[0.3em]">
          NOTE: Multi-stage form logic currently functioning as UI preview stub. Backend integrations (Supabase, CRM) pending provisioning.
        </div>
      </div>
    </div>
  </main>
</Layout>
