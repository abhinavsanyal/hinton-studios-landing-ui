---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Hinton Studios — AI Filmmaking & Spec Ad Production | Cinema Redefined" 
  description="India's premier AI filmmaking studio. We create cinematic AI spec ads, AI-generated commercials, short films & branded content. Human-directed, AI-executed. Experience the future of advertising."
  keywords="ai filmmaking, ai spec ads, ai film production, ai advertisements, generative ai cinema, ai video production, ai content creation, ai commercial production, ai filmmaking studio, ai generated films"
  hasHeroParticles={true}
>
  <!-- ================= HERO ================= -->
  <main class="relative min-h-screen flex flex-col justify-center overflow-hidden">
    <div class="monitor-bracket corner-tl"></div>
    <div class="monitor-bracket corner-tr"></div>
    <div class="monitor-bracket corner-bl"></div>
    <div class="monitor-bracket corner-br"></div>

    <div class="absolute inset-0 z-0 overflow-hidden bg-[#030303]">
      <!-- Infinite Scrolling Slanted Panel Wrapper -->
      <div class="absolute inset-y-0 w-full left-0 skew-x-0 md:w-[150%] md:-left-[25%] md:-skew-x-12 opacity-90 overflow-hidden">
        
        <div class="flex h-full w-[400vw] animate-slow-pan hw-accel">
          <!-- P1: 3AM Skincare -->
          <div class="w-[50vw] relative overflow-hidden border-r border-white/5 grayscale brightness-[0.85] transition-all duration-1000 hover:grayscale-0 hover:brightness-100 hw-accel">
             <iframe class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[250vw] h-[140.625vw] md:w-[150vw] md:h-[84.375vw] max-w-none origin-center skew-x-0 md:skew-x-12 pointer-events-none hw-accel" src="https://www.youtube.com/embed/sDfixts3h4o?autoplay=1&mute=1&playsinline=1&loop=1&playlist=sDfixts3h4o&controls=0&showinfo=0&rel=0" allow="autoplay; fullscreen; picture-in-picture" frameborder="0"></iframe>
          </div>
          <!-- P2: Thirsty -->
          <div class="w-[50vw] relative overflow-hidden border-r border-white/5 grayscale contrast-125 transition-all duration-1000 hover:grayscale-0 hover:contrast-100 hw-accel">
             <iframe class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[250vw] h-[140.625vw] md:w-[150vw] md:h-[84.375vw] max-w-none origin-center skew-x-0 md:skew-x-12 pointer-events-none hw-accel" src="https://www.youtube.com/embed/cbFiwFXRqn0?autoplay=1&mute=1&playsinline=1&loop=1&playlist=cbFiwFXRqn0&controls=0&showinfo=0&rel=0" allow="autoplay; fullscreen; picture-in-picture" frameborder="0"></iframe>
          </div>
          <!-- P3: Alone -->
          <div class="w-[50vw] relative overflow-hidden border-r border-white/5 opacity-80 transition-all duration-1000 hover:opacity-100 hw-accel">
             <iframe class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[250vw] h-[140.625vw] md:w-[150vw] md:h-[84.375vw] max-w-none origin-center skew-x-0 md:skew-x-12 pointer-events-none hw-accel" src="https://www.youtube.com/embed/EEgggVtn1B0?autoplay=1&mute=1&playsinline=1&loop=1&playlist=EEgggVtn1B0&controls=0&showinfo=0&rel=0" allow="autoplay; fullscreen; picture-in-picture" frameborder="0"></iframe>
          </div>
          <!-- P4: Star Performer -->
          <div class="w-[50vw] relative overflow-hidden border-r border-white/5 grayscale brightness-[0.7] transition-all duration-1000 hover:grayscale-0 hover:brightness-100 hw-accel">
             <iframe class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[250vw] h-[140.625vw] md:w-[150vw] md:h-[84.375vw] max-w-none origin-center skew-x-0 md:skew-x-12 pointer-events-none hw-accel" src="https://www.youtube.com/embed/icHxNil5dvg?autoplay=1&mute=1&playsinline=1&loop=1&playlist=icHxNil5dvg&controls=0&showinfo=0&rel=0" allow="autoplay; fullscreen; picture-in-picture" frameborder="0"></iframe>
          </div>

          <!-- DUPLICATES FOR SEAMLESS LOOP -->
          <div class="w-[50vw] relative overflow-hidden border-r border-white/5 grayscale brightness-[0.85] transition-all duration-1000 hover:grayscale-0 hover:brightness-100 hw-accel">
             <iframe class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[250vw] h-[140.625vw] md:w-[150vw] md:h-[84.375vw] max-w-none origin-center skew-x-0 md:skew-x-12 pointer-events-none hw-accel" src="https://www.youtube.com/embed/sDfixts3h4o?autoplay=1&mute=1&playsinline=1&loop=1&playlist=sDfixts3h4o&controls=0&showinfo=0&rel=0" allow="autoplay; fullscreen; picture-in-picture" frameborder="0"></iframe>
          </div>
          <div class="w-[50vw] relative overflow-hidden border-r border-white/5 grayscale contrast-125 transition-all duration-1000 hover:grayscale-0 hover:contrast-100 hw-accel">
             <iframe class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[250vw] h-[140.625vw] md:w-[150vw] md:h-[84.375vw] max-w-none origin-center skew-x-0 md:skew-x-12 pointer-events-none hw-accel" src="https://www.youtube.com/embed/cbFiwFXRqn0?autoplay=1&mute=1&playsinline=1&loop=1&playlist=cbFiwFXRqn0&controls=0&showinfo=0&rel=0" allow="autoplay; fullscreen; picture-in-picture" frameborder="0"></iframe>
          </div>
          <div class="w-[50vw] relative overflow-hidden border-r border-white/5 opacity-80 transition-all duration-1000 hover:opacity-100 hw-accel">
             <iframe class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[250vw] h-[140.625vw] md:w-[150vw] md:h-[84.375vw] max-w-none origin-center skew-x-0 md:skew-x-12 pointer-events-none hw-accel" src="https://www.youtube.com/embed/EEgggVtn1B0?autoplay=1&mute=1&playsinline=1&loop=1&playlist=EEgggVtn1B0&controls=0&showinfo=0&rel=0" allow="autoplay; fullscreen; picture-in-picture" frameborder="0"></iframe>
          </div>
          <div class="w-[50vw] relative overflow-hidden border-r border-white/5 grayscale brightness-[0.7] transition-all duration-1000 hover:grayscale-0 hover:brightness-100 hw-accel">
             <iframe class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[250vw] h-[140.625vw] md:w-[150vw] md:h-[84.375vw] max-w-none origin-center skew-x-0 md:skew-x-12 pointer-events-none hw-accel" src="https://www.youtube.com/embed/icHxNil5dvg?autoplay=1&mute=1&playsinline=1&loop=1&playlist=icHxNil5dvg&controls=0&showinfo=0&rel=0" allow="autoplay; fullscreen; picture-in-picture" frameborder="0"></iframe>
          </div>
        </div>
      </div>
      
      <!-- Dark Gradients over the video -->
      <div class="absolute inset-0 bg-gradient-to-b from-[#030303]/80 via-[#030303]/10 to-[#030303]/90 pointer-events-none z-10"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_0%,rgba(3,3,3,0.5)_100%)] pointer-events-none z-10"></div>
    </div>

    <div class="relative z-10 container mx-auto px-5 md:px-12 pt-36 md:pt-32 pb-20">
      <div class="max-w-6xl">
        <div class="flex items-center gap-3 md:gap-4 mb-10 md:mb-8 max-md:flex-wrap" data-reveal>
          <div class="h-px w-8 md:w-12 bg-outline-variant/40"></div>
          <span class="font-label text-[8px] md:text-[10px] tracking-[0.2em] md:tracking-[0.3em] uppercase text-tertiary max-md:backdrop-blur-md max-md:bg-white/5 max-md:px-3 max-md:py-1 max-md:rounded-full max-md:border max-md:border-white/10">STNBY // RENDER_MODE_AI_4.2</span>
          <div class="flex items-center gap-2 ml-2 md:ml-4">
            <span class="w-1.5 h-1.5 bg-error rounded-full animate-pulse-soft max-md:shadow-[0_0_8px_rgba(255,0,0,0.8)]"></span>
            <span class="font-label text-[8px] md:text-[10px] tracking-[0.2em] md:tracking-[0.3em] uppercase text-outline" data-clock>00:00:00 UTC</span>
          </div>
        </div>

        <h1 class="font-headline text-[15vw] md:text-7xl lg:text-8xl max-md:leading-[0.8] md:leading-tight font-light max-md:tracking-[0.05em] md:tracking-[0.1em] text-white uppercase mb-6 md:mb-4" data-reveal data-hero-title>
          Cinema
          <span class="block max-md:ml-[15vw] md:ml-24 font-bold text-transparent bg-clip-text max-md:bg-gradient-to-br md:bg-gradient-to-r from-white via-white/80 to-white/30 tracking-[0.1em] md:tracking-[0.15em] max-md:pb-1">Redefined.</span>
        </h1>
        <h2 class="font-body text-[14px] md:text-2xl text-tertiary font-light italic tracking-wider md:tracking-widest max-w-xl max-md:bg-white/5 max-md:backdrop-blur-xl max-md:border max-md:border-white/10 max-md:rounded-full max-md:px-6 max-md:py-2.5 md:border-l-[1px] md:border-tertiary/40 md:pl-6 max-md:mt-8 mb-12 md:mb-16 lowercase max-md:shadow-[0_4px_30px_rgba(0,0,0,0.1)] w-fit" data-reveal style="--reveal-delay: 80ms">
          ai films with a soul.
        </h2>

        <div class="flex flex-col md:flex-row items-stretch md:items-center gap-8 md:gap-24" data-reveal style="--reveal-delay: 120ms">
          <p class="max-w-md font-body text-[11px] md:text-base text-outline uppercase max-md:tracking-[0.12em] md:tracking-[0.15em] max-md:leading-relaxed md:leading-loose mix-blend-screen max-md:bg-black/30 max-md:backdrop-blur-md max-md:p-5 max-md:rounded-2xl max-md:border max-md:border-white/5 max-md:shadow-2xl">
            Traditional filmmaking intelligence meets generative AI.<br/>Films that make you
            feel.<br/><span class="text-white mt-4 block">Experience the next era of digital auteurism.</span>
          </p>
          <div class="group relative max-md:mt-4">
            <div class="absolute -inset-4 opacity-0 group-hover:opacity-100 transition-opacity duration-500 max-md:hidden" style="background: radial-gradient(circle, rgba(144, 147, 255, 0.15) 0%, transparent 70%);"></div>
            <div class="absolute inset-0 bg-[#9093ff] opacity-10 rounded-full blur-xl md:hidden"></div>
            <a href="/work" data-magnetic="0.25" class="relative flex md:inline-flex justify-between md:justify-center items-center gap-3 max-md:bg-white/5 max-md:backdrop-blur-xl max-md:border max-md:border-primary/40 max-md:rounded-full max-md:text-white bg-primary text-on-primary px-8 md:px-12 py-5 text-[11px] md:text-sm font-bold font-headline tracking-[0.2em] transition-all duration-300 hover:bg-white hover:text-black max-md:shadow-[inset_0_1px_1px_rgba(255,255,255,0.1),0_0_20px_rgba(144,147,255,0.15)] max-md:active:scale-95">
              START YOUR STORY
              <span class="material-symbols-outlined text-base max-md:text-primary max-md:bg-white/10 max-md:p-1 max-md:rounded-full group-hover:translate-x-1 transition-transform">arrow_right_alt</span>
            </a>
          </div>
        </div>
      </div>

      <div class="hidden lg:flex absolute bottom-12 left-12 right-12 justify-between items-end border-t border-outline-variant/10 pt-8">
        <div class="flex gap-16 font-label text-[10px] tracking-widest text-outline uppercase">
          <div>
            <p class="text-tertiary mb-1">FPS</p>
            <p class="text-on-surface">23.976</p>
          </div>
          <div>
            <p class="text-tertiary mb-1">ISO</p>
            <p class="text-on-surface">800</p>
          </div>
          <div>
            <p class="text-tertiary mb-1">RESOLUTION</p>
            <p class="text-on-surface">8K UNCOMPRESSED</p>
          </div>
          <div>
            <p class="text-tertiary mb-1">LENS</p>
            <p class="text-on-surface">ANAMORPHIC 2.39:1</p>
          </div>
        </div>
        <div class="flex items-center gap-4 text-outline font-label text-[10px] tracking-[0.3em]">
          <span class="material-symbols-outlined text-[14px]">videocam</span>
          RECORDING LIVE
        </div>
      </div>
    </div>
  </main>

  <!-- ================= SHOWCASE BENTO ================= -->
  <section class="bg-surface py-32 px-6 md:px-12 relative overflow-hidden">
    <div class="container mx-auto">
      <div class="flex items-end justify-between mb-16" data-reveal>
        <div>
          <span class="font-label text-[10px] tracking-[0.3em] uppercase text-tertiary mb-4 block">INDEX // 001</span>
          <h2 class="font-headline text-4xl md:text-6xl font-bold tracking-tighter uppercase">
            Featured Signal
          </h2>
        </div>
        <a href="/work" class="hidden md:inline-flex items-center gap-3 font-headline text-xs font-bold tracking-widest uppercase text-outline hover:text-primary transition-colors border-b border-outline-variant/30 hover:border-primary pb-1">
          View all work
          <span class="material-symbols-outlined text-sm">arrow_right_alt</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        <div class="md:col-span-8 group relative bg-surface-container-low aspect-[21/9] overflow-hidden border border-outline-variant/10" data-reveal>
          <iframe class="w-full h-full pointer-events-auto scale-[1.3]" src="https://www.youtube.com/embed/cbFiwFXRqn0?autoplay=1&mute=1&loop=1&playlist=cbFiwFXRqn0&controls=1" title="Thirsty | Horror comedy AD" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share;" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent pointer-events-none"></div>
          <div class="absolute top-8 left-8 font-label text-[10px] text-tertiary tracking-[0.3em] uppercase pointer-events-none">PROJECT 001</div>
          <div class="absolute bottom-8 left-8 right-8 flex items-end justify-between pointer-events-none">
            <div>
              <h3 class="font-headline text-3xl md:text-4xl font-bold uppercase tracking-tighter text-white mb-2">Thirsty</h3>
              <p class="font-label text-[10px] tracking-[0.3em] uppercase text-outline">Horror Comedy AD</p>
            </div>
            <span class="material-symbols-outlined text-4xl text-white/60 group-hover:text-tertiary group-hover:translate-x-2 transition-all duration-500">arrow_outward</span>
          </div>
        </div>

        <div class="md:col-span-4 bg-surface-container-high p-8 flex flex-col justify-between border border-outline-variant/10" data-reveal style="--reveal-delay: 80ms">
          <div class="font-label text-[10px] text-tertiary tracking-[0.3em] uppercase">Methodology</div>
          <div>
            <h4 class="font-headline text-2xl font-bold mb-4 uppercase tracking-tighter">Emotional Logic</h4>
            <p class="text-sm text-on-surface-variant leading-relaxed font-light">Our process leads with profound human intellect for scripting, storyboarding, and directing, then unleashes 100% generative AI for flawless physical production.</p>
          </div>
          <a href="/process" class="text-[11px] font-bold tracking-[0.2em] border-b border-tertiary pb-1 hover:text-tertiary transition-colors uppercase self-start">EXPLORE TECH</a>
        </div>

        <div class="md:col-span-4 bg-surface-container aspect-square overflow-hidden group border border-outline-variant/10 relative" data-reveal>
          <iframe class="w-full h-full pointer-events-auto scale-[1.3]" src="https://www.youtube.com/embed/sDfixts3h4o?autoplay=1&mute=1&loop=1&playlist=sDfixts3h4o&controls=1" title="3AM Skincare | Horror comedy AD" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share;" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
          <div class="absolute top-6 right-6 font-label text-[10px] text-on-surface/50 pointer-events-none">PROJECT 02</div>
          <div class="absolute bottom-6 left-6 font-label text-[10px] text-tertiary tracking-[0.3em] uppercase pointer-events-none">3AM Skincare</div>
        </div>

        <div class="md:col-span-8 bg-surface-container-highest p-12 relative overflow-hidden border border-outline-variant/10" data-reveal style="--reveal-delay: 80ms">
          <div class="relative z-10 flex flex-col h-full justify-center max-w-xl">
            <h3 class="font-headline text-4xl md:text-5xl font-bold mb-6 tracking-tighter uppercase leading-[0.9]">Where Human Intellect Drives Algorithmic Execution.</h3>
            <p class="text-on-surface-variant font-light mb-8">Hinton Studios bridges the gap between imagination and the silver screen through a powerhouse hybrid of manual filmmaking creativity and 100% generative AI production workflows.</p>
            <div class="flex gap-4 items-center">
              <span class="w-2 h-2 bg-tertiary rounded-full"></span>
              <span class="w-2 h-2 bg-outline-variant rounded-full"></span>
              <span class="w-2 h-2 bg-outline-variant rounded-full"></span>
              <a href="/services" class="ml-6 font-headline text-xs font-bold tracking-widest uppercase hover:text-tertiary transition-colors">Our Capabilities →</a>
            </div>
          </div>
          <div class="absolute -right-20 -bottom-20 w-80 h-80 rounded-full" style="background: radial-gradient(circle, rgba(144, 147, 255, 0.08) 0%, transparent 70%);"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= CTA STRIP ================= -->
  <section class="py-32 px-6 md:px-12 text-center relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 60% 50% at 50% 50%, rgba(144, 147, 255, 0.07) 0%, transparent 70%);"></div>
    <div class="relative max-w-5xl mx-auto" data-reveal>
      <span class="font-label text-[11px] tracking-[0.3em] uppercase text-tertiary mb-8 block">Ready to transcend?</span>
      <h3 class="font-headline text-5xl md:text-8xl font-bold tracking-tighter uppercase leading-[0.85] mb-12">
        Begin the<br />
        <span class="video-text-fill" style="background-image: url('https://img.youtube.com/vi/icHxNil5dvg/maxresdefault.jpg'); font-style: italic;">Transcendence.</span>
      </h3>
      <a href="/start-project" class="group relative inline-flex items-center justify-center px-12 py-7 md:px-16 md:py-8 border border-primary/20 hover:border-tertiary transition-all duration-500 overflow-hidden">
        <span class="absolute inset-0 bg-tertiary translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-out"></span>
        <span class="relative font-headline font-bold text-lg md:text-2xl tracking-tighter uppercase text-primary group-hover:text-black flex items-center gap-5 transition-colors duration-500">
          Get A Quote
          <span class="material-symbols-outlined text-2xl md:text-3xl group-hover:translate-x-2 transition-transform duration-500">arrow_right_alt</span>
        </span>
      </a>
      <a href="/book-call" class="group relative inline-flex items-center justify-center px-12 py-7 md:px-16 md:py-8 border border-outline-variant/20 hover:border-tertiary transition-all duration-500 overflow-hidden">
        <span class="absolute inset-0 bg-white/5 translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-out"></span>
        <span class="relative font-headline font-bold text-lg md:text-2xl tracking-tighter uppercase text-outline group-hover:text-white flex items-center gap-5 transition-colors duration-500">
          <span class="material-symbols-outlined text-2xl md:text-3xl">videocam</span>
          Book A Call
        </span>
      </a>
      <p class="mt-12 font-label text-[10px] uppercase tracking-[0.4em] text-outline opacity-50">
        Selective Engagement — Now Booking Q2 / Q3 2026
      </p>
    </div>
  </section>
</Layout>
