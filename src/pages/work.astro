---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="AI Film Portfolio — Spec Ads & Short Films Made with AI | Hinton Studios" 
  description="Explore our portfolio of AI-generated spec ads, AI short films, and AI commercials. See how generative AI filmmaking creates Hollywood-quality content at Hinton Studios."
  keywords="ai film portfolio, ai spec ads portfolio, ai short film examples, ai generated commercials, ai filmmaking showcase, ai advertisement examples, ai video production portfolio"
>
  <main class="pt-32 pb-24">
    <!-- HEADER -->
    <header class="px-6 md:px-12 mb-32" data-reveal>
      <div class="flex flex-col md:flex-row justify-between items-end gap-8 max-w-[1600px] mx-auto">
        <div class="max-w-4xl">
          <span class="font-label text-[10px] tracking-[0.4em] uppercase text-tertiary mb-6 block">PROJECT ARCHIVE — MMXXIV</span>
          <h1 class="font-headline text-6xl md:text-9xl font-bold leading-[0.85] tracking-tighter uppercase text-primary">
            SELECTED<br /><span class="video-text-fill" style="background-image: url('https://img.youtube.com/vi/cbFiwFXRqn0/maxresdefault.jpg')">WORKS</span>
          </h1>
        </div>
        <div class="hidden md:flex flex-col text-right pb-4 gap-2">
          <p class="font-label text-[10px] text-outline tracking-widest uppercase opacity-60">HUMAN DIRECTED / AI GENERATED</p>
          <p class="font-label text-[10px] text-outline tracking-widest uppercase opacity-60">01 — COLLECTION</p>
          <p class="font-label text-[10px] text-tertiary tracking-widest uppercase opacity-80" data-clock>00:00:00 UTC</p>
        </div>
      </div>
    </header>

    <!-- GALLERY -->
    <section class="flex flex-col gap-32 md:gap-48">
      
      <!-- FEATURED 1: Thirsty -->
      <div class="px-6 md:px-12 max-w-[1600px] mx-auto w-full" data-reveal>
        <div class="group relative">
          <div class="relative aspect-[16/9] md:aspect-[21/9] overflow-hidden cinematic-grade-teal">
            <iframe class="w-full h-full scale-[1.3] pointer-events-auto" src="https://www.youtube.com/embed/cbFiwFXRqn0?autoplay=1&mute=1&loop=1&playlist=cbFiwFXRqn0&controls=1" title="Thirsty | Horror comedy AD" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
            <div class="absolute inset-0 bg-gradient-to-t from-background/90 via-transparent to-transparent pointer-events-none"></div>
          </div>
          <div class="absolute -bottom-10 md:-bottom-16 left-0 md:left-12 z-20 pointer-events-none">
            <span class="font-label text-[9px] tracking-[0.5em] text-tertiary uppercase mb-2 block">FEATURED / 01</span>
            <h2 class="font-headline text-5xl md:text-8xl font-bold uppercase tracking-tighter text-primary overlap-text leading-none hover:text-white transition-colors duration-500 inline-block pointer-events-auto"><a href="/work/thirsty">Thirsty</a></h2>
            <div class="mt-4 md:mt-6 flex flex-wrap gap-4 md:gap-6 items-center">
              <span class="font-label text-[8px] tracking-[0.4em] text-outline uppercase">GENRE: HORROR COMEDY AD</span>
              <div class="h-px w-8 md:w-12 bg-outline-variant/30"></div>
              <span class="font-label text-[8px] tracking-[0.4em] text-outline uppercase">RUNTIME: 0:59</span>
            </div>
            <a href="/work/thirsty" class="mt-8 inline-flex items-center gap-4 font-headline text-xs font-bold tracking-[0.3em] uppercase text-on-primary bg-primary hover:bg-white hover:text-black transition-colors px-6 py-3 pointer-events-auto shadow-xl">VIEW CASE STUDY <span class="material-symbols-outlined text-sm">arrow_right_alt</span></a>
          </div>
        </div>
      </div>

      <!-- FEATURED 2: 3AM Skincare -->
      <div class="px-6 md:px-12 max-w-[1600px] mx-auto w-full" data-reveal>
        <div class="group relative">
          <div class="relative aspect-[16/9] md:aspect-[21/9] overflow-hidden cinematic-grade-teal">
            <iframe class="w-full h-full scale-[1.3] pointer-events-auto" src="https://www.youtube.com/embed/sDfixts3h4o?autoplay=1&mute=1&loop=1&playlist=sDfixts3h4o&controls=1" title="3AM Skincare | Horror comedy AD" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
            <div class="absolute inset-0 bg-gradient-to-t from-background/90 via-transparent to-transparent pointer-events-none"></div>
          </div>
          <div class="absolute -bottom-10 md:-bottom-16 right-0 md:right-12 text-right pointer-events-none">
            <span class="font-label text-[9px] tracking-[0.5em] text-tertiary uppercase mb-2 block">FEATURED / 02</span>
            <h2 class="font-headline text-5xl md:text-8xl font-bold uppercase tracking-tighter text-primary overlap-text leading-none hover:text-white transition-colors duration-500 inline-block pointer-events-auto"><a href="/work/3am-skincare">3AM SKINCARE</a></h2>
            <div class="mt-4 md:mt-6 flex flex-wrap gap-4 md:gap-6 items-center justify-end">
              <span class="font-label text-[8px] tracking-[0.4em] text-outline uppercase">GENRE: HORROR COMEDY AD</span>
              <div class="h-px w-8 md:w-12 bg-outline-variant/30"></div>
              <span class="font-label text-[8px] tracking-[0.4em] text-outline uppercase">RUNTIME: 1:30</span>
            </div>
            <a href="/work/3am-skincare" class="mt-8 inline-flex items-center gap-4 font-headline text-xs font-bold tracking-[0.3em] uppercase text-on-primary bg-primary hover:bg-white hover:text-black transition-colors px-6 py-3 pointer-events-auto shadow-xl">VIEW CASE STUDY <span class="material-symbols-outlined text-sm">arrow_right_alt</span></a>
          </div>
        </div>
      </div>

      <!-- PROJECT 3: Alone -->
      <div class="px-6 md:px-12 grid grid-cols-12 gap-8 max-w-[1600px] mx-auto w-full" data-reveal>
        <div class="col-span-12 md:col-span-8 group relative">
          <div class="relative aspect-[4/3] md:aspect-[16/9] overflow-hidden cinematic-grade-teal">
            <iframe class="w-full h-full scale-[1.3] pointer-events-auto grayscale contrast-110 brightness-90" src="https://www.youtube.com/embed/EEgggVtn1B0?autoplay=1&mute=1&loop=1&playlist=EEgggVtn1B0&controls=1" title="Alone | One minute horror short film" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
            <div class="absolute inset-0 bg-gradient-to-t from-background/80 via-transparent to-transparent pointer-events-none"></div>
          </div>
          <div class="absolute -bottom-8 md:-bottom-12 left-0 z-20 pointer-events-none">
            <span class="font-label text-[9px] tracking-[0.5em] text-tertiary uppercase mb-2 block">PROJECT / 03</span>
            <h2 class="font-headline text-4xl md:text-6xl font-bold uppercase tracking-tighter text-primary overlap-text leading-none hover:text-white transition-colors duration-500 inline-block pointer-events-auto"><a href="/work/alone">ALONE</a></h2>
            <div class="mt-4 flex gap-4 items-center">
              <span class="font-label text-[8px] tracking-[0.4em] text-outline uppercase">ONE MINUTE HORROR</span>
            </div>
            <a href="/work/alone" class="mt-8 inline-flex items-center gap-4 font-headline text-xs font-bold tracking-[0.3em] uppercase text-on-primary bg-primary hover:bg-white hover:text-black transition-colors px-6 py-3 pointer-events-auto shadow-xl">VIEW CASE STUDY <span class="material-symbols-outlined text-sm">arrow_right_alt</span></a>
          </div>
        </div>
      </div>

      <!-- PROJECT 4: Star Performer -->
      <div class="px-6 md:px-12 grid grid-cols-12 gap-12 md:gap-24 items-center max-w-[1600px] mx-auto w-full" data-reveal>
        <div class="col-span-12 md:col-span-5 order-2 md:order-1">
          <div class="max-w-md pointer-events-none">
            <span class="font-label text-[9px] tracking-[0.5em] text-tertiary uppercase mb-4 block">PROJECT / 04</span>
            <h2 class="font-headline text-4xl md:text-6xl font-bold uppercase tracking-tighter text-primary leading-tight mb-6 hover:text-white transition-colors duration-500 inline-block pointer-events-auto"><a href="/work/star-performer">STAR<br/>PERFORMER</a></h2>
            <p class="font-body text-outline text-sm leading-relaxed mb-4">Corporate anxiety meets sheer terror. A psychological descent into the modern workplace.</p>
            <div class="flex flex-col gap-4 mb-8">
              <span class="font-label text-[8px] tracking-[0.4em] text-outline uppercase">GENRE: HORROR SHORT</span>
            </div>
            <a href="/work/star-performer" class="inline-flex items-center gap-4 font-headline text-xs font-bold tracking-[0.3em] uppercase text-on-primary bg-primary hover:bg-white hover:text-black transition-colors px-6 py-3 pointer-events-auto shadow-xl">VIEW CASE STUDY <span class="material-symbols-outlined text-sm">arrow_right_alt</span></a>
          </div>
        </div>
        <div class="col-span-12 md:col-span-7 order-1 md:order-2 group relative">
          <div class="relative aspect-video overflow-hidden cinematic-grade-teal border-l-4 border-tertiary/20">
            <iframe class="w-full h-full scale-[1.3] pointer-events-auto" src="https://www.youtube.com/embed/icHxNil5dvg?autoplay=1&mute=1&loop=1&playlist=icHxNil5dvg&controls=1" title="Star Performer of the month | One minute horror short film" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
            <div class="absolute inset-0 bg-gradient-to-t from-background/40 to-transparent pointer-events-none"></div>
          </div>
        </div>
      </div>
    </section>
    <section class="mt-64 md:mt-96 px-6 md:px-12">
      <div class="max-w-4xl mx-auto text-center border-y border-outline-variant/10 py-32 md:py-48" data-reveal>
        <span class="font-label text-[9px] tracking-[0.6em] text-tertiary uppercase mb-12 block">COLLABORATION</span>
        <h3 class="font-headline text-4xl md:text-6xl font-bold uppercase tracking-tighter text-primary mb-12 leading-[0.9]">
          Transforming visions<br />into digital artifacts.
        </h3>
        <div class="flex flex-col md:flex-row justify-center items-center gap-6">
          <a href="/start-project" class="font-headline text-xs font-bold tracking-[0.3em] uppercase px-12 py-5 bg-primary text-on-primary hover:bg-tertiary transition-colors duration-500">GET A QUOTE</a>
          <a href="/book-call" class="font-headline text-xs font-bold tracking-[0.3em] uppercase px-12 py-5 border border-primary/30 text-primary hover:bg-primary hover:text-on-primary transition-all duration-500 flex items-center gap-3">
            <span class="material-symbols-outlined text-base">videocam</span>
            BOOK A CALL
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
