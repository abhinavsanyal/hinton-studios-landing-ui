---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Hinton Studios — 404 Not Found" description="The requested path could not be located in our databanks.">
  <main class="min-h-screen pt-32 pb-24 flex items-center justify-center">
    <!-- 404 Visuals -->
    <div class="px-6 md:px-12 w-full max-w-5xl mx-auto flex flex-col items-center justify-center text-center relative" data-reveal>
      
      <!-- Backdrop noise -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(255,0,0,0.05),transparent_70%)] pointer-events-none"></div>

      <span class="font-label text-[11px] uppercase tracking-[0.4em] text-error mb-6 flex items-center gap-3 font-bold border border-error/30 px-6 py-2 bg-error/10">
        <div class="w-2 h-2 bg-error rounded-full animate-pulse-soft"></div>
        SIGNAL_LOST // 404
      </span>

      <h1 class="font-headline text-[20vw] md:text-[15vw] font-bold tracking-tighter text-outline-variant/30 leading-none select-none mb-8 relative">
        404
        <!-- Glitch layers -->
        <span class="absolute top-0 left-[2px] -z-10 text-error/40 animate-pulse mix-blend-screen">404</span>
        <span class="absolute top-0 -left-[2px] -z-10 text-primary/40 animate-pulse mix-blend-screen delay-75">404</span>
      </h1>

      <p class="font-body text-xl max-w-lg text-on-surface-variant font-light mb-12">
        The requested transmission could not be located in our databanks. The architectural blueprint may have been altered or destroyed.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 w-full max-w-2xl text-left border-y border-outline-variant/20 py-8 mb-12">
        <a href="/work" class="group flex items-center justify-between p-4 border border-outline-variant/10 hover:border-tertiary hover:bg-surface-container-low transition-all">
          <span class="font-label text-[10px] tracking-widest text-outline uppercase group-hover:text-tertiary">Explore Work</span>
          <span class="material-symbols-outlined text-outline-variant group-hover:text-tertiary transition-transform group-hover:translate-x-1">arrow_right_alt</span>
        </a>
        <a href="/services" class="group flex items-center justify-between p-4 border border-outline-variant/10 hover:border-tertiary hover:bg-surface-container-low transition-all">
          <span class="font-label text-[10px] tracking-widest text-outline uppercase group-hover:text-tertiary">Our Services</span>
          <span class="material-symbols-outlined text-outline-variant group-hover:text-tertiary transition-transform group-hover:translate-x-1">arrow_right_alt</span>
        </a>
        <a href="/process" class="group flex items-center justify-between p-4 border border-outline-variant/10 hover:border-tertiary hover:bg-surface-container-low transition-all">
          <span class="font-label text-[10px] tracking-widest text-outline uppercase group-hover:text-tertiary">The Process</span>
          <span class="material-symbols-outlined text-outline-variant group-hover:text-tertiary transition-transform group-hover:translate-x-1">arrow_right_alt</span>
        </a>
        <a href="/" class="group flex items-center justify-between p-4 border border-outline-variant/10 hover:border-tertiary hover:bg-surface-container-low transition-all">
          <span class="font-label text-[10px] tracking-widest text-outline uppercase group-hover:text-tertiary">Return to Base</span>
          <span class="material-symbols-outlined text-outline-variant group-hover:text-tertiary transition-transform group-hover:translate-x-1">home</span>
        </a>
      </div>

      <div class="font-label text-[9px] uppercase tracking-[0.3em] text-outline">
        STILL LOST? <a href="mailto:hello@hintonstudios.com" class="text-tertiary hover:text-white border-b border-tertiary/30 hover:border-white pb-0.5 transition-all ml-2">ESTABLISH COMM LINK</a>
      </div>
    </div>
  </main>
</Layout>
