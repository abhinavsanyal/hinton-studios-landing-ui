---
import Layout from './Layout.astro';
import CostCalculator from '../components/CostCalculator.astro';

interface Props {
  title: string;
  slug: string;
  tagline: string;
  description: string;
  metaDescription: string;
  keywords: string;
  icon: string;
  heroLabel: string;
  features: Array<{title: string; description: string; icon: string}>;
  process: Array<{step: string; title: string; description: string}>;
  deliverables: string[];
  videoId?: string;
  relatedServices: Array<{title: string; slug: string; icon: string}>;
  calculatorType?: 'ai-film' | 'short-film' | 'tv-commercial' | 'ugc' | 'creative-strategy';
}

const { 
  title, slug, tagline, description, metaDescription, keywords, icon, heroLabel,
  features, process, deliverables, videoId, relatedServices, calculatorType
} = Astro.props;

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": title,
  "description": metaDescription,
  "url": `https://www.hintonstudios.com/services/${slug}`,
  "provider": {
    "@type": "Organization",
    "name": "Hinton Studios",
    "url": "https://www.hintonstudios.com"
  },
  "areaServed": "Worldwide",
  "serviceType": title
};
---

<Layout title={`${title} — AI Production Services | Hinton Studios`} description={metaDescription} keywords={keywords}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
  
  <main class="pt-32 pb-0">
    <!-- Hero -->
    <section class="px-6 md:px-12 mb-24 max-w-[1600px] mx-auto relative" data-reveal>
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-8">
        <div class="max-w-4xl relative">
          <span class="font-label text-[11px] tracking-[0.2em] uppercase text-tertiary mb-6 block">{heroLabel}</span>
          <h1 class="font-headline text-5xl md:text-8xl font-bold tracking-tighter leading-[0.85] text-primary uppercase">
            {title}
          </h1>
          <p class="mt-6 font-body text-xl text-on-surface-variant max-w-2xl leading-relaxed italic">
            {tagline}
          </p>
        </div>
        <div class="flex items-center gap-3 mb-6">
          <span class="material-symbols-outlined text-5xl text-tertiary/60">{icon}</span>
        </div>
      </div>
    </section>

    <!-- Video Showcase (if available) -->
    {videoId && (
      <section class="px-6 md:px-12 mb-24 max-w-[1600px] mx-auto" data-reveal style="--reveal-delay: 80ms">
        <div class="relative aspect-video bg-black/90 overflow-hidden border border-outline-variant/10">
          <iframe 
            class="w-full h-full pointer-events-auto scale-[1.05]" 
            src={`https://www.youtube.com/embed/${videoId}?autoplay=1&mute=1&loop=1&playlist=${videoId}&controls=1`} 
            title={title} 
            loading="lazy" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
            referrerpolicy="strict-origin-when-cross-origin" 
            allowfullscreen>
          </iframe>
          <div class="absolute inset-0 bg-gradient-to-t from-background via-transparent to-transparent pointer-events-none"></div>
        </div>
      </section>
    )}

    <!-- Overview -->
    <section class="px-6 md:px-12 mb-32 max-w-[1600px] mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-16 items-start">
        <div class="md:col-span-7" data-reveal>
          <span class="font-label text-[11px] tracking-[0.3em] uppercase text-tertiary mb-6 block font-bold">Overview</span>
          <div class="font-body text-lg text-on-surface-variant leading-relaxed space-y-6">
            <p>{description}</p>
          </div>
        </div>
        <div class="md:col-span-5" data-reveal style="--reveal-delay: 100ms">
          <span class="font-label text-[11px] tracking-[0.3em] uppercase text-tertiary mb-6 block font-bold">Deliverables</span>
          <div class="border border-outline-variant/20 bg-black/40 backdrop-blur p-6 md:p-8">
            <ul class="space-y-4">
              {deliverables.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="material-symbols-outlined text-tertiary text-sm mt-0.5">check</span>
                  <span class="font-body text-sm text-on-surface-variant">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- What We Deliver -->
    <section class="px-6 md:px-12 py-32 bg-surface-container-low relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(112,115,255,0.04),transparent_60%)] pointer-events-none"></div>
      <div class="max-w-[1600px] mx-auto relative z-10">
        <div class="mb-16" data-reveal>
          <span class="font-label text-[11px] tracking-[0.3em] uppercase text-tertiary mb-4 block font-bold">Capabilities</span>
          <h2 class="font-headline text-4xl md:text-6xl font-bold tracking-tighter uppercase leading-tight">What We Deliver</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-outline-variant/10">
          {features.map((feature, i) => (
            <div class="bg-surface-container-low p-8 md:p-12 group hover:bg-surface-container transition-colors duration-500" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
              <span class="material-symbols-outlined text-3xl text-tertiary/60 mb-6 block group-hover:text-tertiary transition-colors">{feature.icon}</span>
              <h3 class="font-headline text-xl font-bold text-white uppercase tracking-tighter mb-4">{feature.title}</h3>
              <p class="font-body text-sm text-on-surface-variant leading-relaxed">{feature.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Process -->
    <section class="px-6 md:px-12 py-32 max-w-[1600px] mx-auto">
      <div class="mb-16" data-reveal>
        <span class="font-label text-[11px] tracking-[0.3em] uppercase text-tertiary mb-4 block font-bold">The Process</span>
        <h2 class="font-headline text-4xl md:text-6xl font-bold tracking-tighter uppercase leading-tight">How We Work</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {process.map((step, i) => (
          <div class="relative group" data-reveal style={`--reveal-delay: ${i * 100}ms`}>
            <div class="border border-outline-variant/20 p-8 bg-black/30 backdrop-blur h-full hover:border-tertiary/40 transition-colors duration-500">
              <span class="font-headline text-5xl font-bold text-outline-variant/15 absolute top-4 right-4">{step.step}</span>
              <span class="font-label text-[10px] tracking-[0.3em] uppercase text-tertiary mb-4 block font-bold">Stage {step.step}</span>
              <h3 class="font-headline text-lg font-bold text-white uppercase tracking-tighter mb-3">{step.title}</h3>
              <p class="font-body text-sm text-on-surface-variant leading-relaxed">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Cost Savings Calculator -->
    {calculatorType && <CostCalculator serviceType={calculatorType} serviceTitle={title} />}

    <!-- Custom content slot -->
    <slot />

    <!-- CTA -->
    <section class="py-32 md:py-48 px-6 md:px-12 text-center relative overflow-hidden bg-black">
      <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 60% 50% at 50% 50%, rgba(144, 147, 255, 0.07) 0%, transparent 70%);"></div>
      <div class="relative max-w-4xl mx-auto" data-reveal>
        <span class="font-label text-[11px] tracking-[0.3em] uppercase text-tertiary mb-8 block font-bold">Ready to Begin?</span>
        <h2 class="font-headline text-5xl md:text-8xl font-bold tracking-tighter uppercase leading-[0.85] mb-12">
          Let's Create<br /><span class="text-tertiary italic">Together.</span>
        </h2>
        <div class="flex flex-col sm:flex-row justify-center items-center gap-6">
          <a href="/start-project" class="group relative inline-flex items-center justify-center px-12 py-7 md:px-20 md:py-9 border border-primary/20 hover:border-tertiary transition-all duration-500 overflow-hidden">
            <span class="absolute inset-0 bg-tertiary translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-out"></span>
            <span class="relative font-headline font-bold text-lg md:text-2xl tracking-tighter uppercase text-primary group-hover:text-black flex items-center gap-5 transition-colors duration-500">
              Get A Quote
              <span class="material-symbols-outlined text-2xl md:text-3xl group-hover:translate-x-2 transition-transform duration-500">arrow_right_alt</span>
            </span>
          </a>
          <a href="/book-call" class="group relative inline-flex items-center justify-center px-12 py-7 md:px-20 md:py-9 border border-outline-variant/20 hover:border-tertiary transition-all duration-500 overflow-hidden">
            <span class="absolute inset-0 bg-white/5 translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-out"></span>
            <span class="relative font-headline font-bold text-lg md:text-2xl tracking-tighter uppercase text-outline group-hover:text-white flex items-center gap-5 transition-colors duration-500">
              <span class="material-symbols-outlined text-2xl md:text-3xl">videocam</span>
              Book A Call
            </span>
          </a>
        </div>
        <p class="mt-12 font-label text-[10px] uppercase tracking-[0.4em] text-outline opacity-50">
          Selective Engagement — Now Booking Q2 / Q3 2026
        </p>
      </div>
    </section>

    <!-- Related Services -->
    <section class="px-6 md:px-12 py-24 bg-surface-container-low border-t border-outline-variant/10">
      <div class="max-w-[1600px] mx-auto">
        <span class="font-label text-[11px] tracking-[0.3em] uppercase text-outline mb-8 block">Other Services</span>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
          {relatedServices.map((service) => (
            <a href={`/services/${service.slug}`} class="group border border-outline-variant/20 p-6 hover:border-tertiary/40 hover:bg-surface-container transition-all duration-500">
              <span class="material-symbols-outlined text-2xl text-outline-variant/40 group-hover:text-tertiary transition-colors mb-3 block">{service.icon}</span>
              <span class="font-headline text-sm font-bold text-white uppercase tracking-tighter group-hover:text-tertiary transition-colors">{service.title}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
