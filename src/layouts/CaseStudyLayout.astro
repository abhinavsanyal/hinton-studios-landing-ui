---
import Layout from './Layout.astro';

interface Props {
  title: string;
  videoId: string;
  metadata: {
    genre: string;
    runtime: string;
    year: string;
    tools: string[];
    role: string;
  };
  brief: string;
  approach: string;
  nextSlug?: string;
  nextTitle?: string;
  prevSlug?: string;
  prevTitle?: string;
}

const { title, videoId, metadata, brief, approach, nextSlug, nextTitle, prevSlug, prevTitle } = Astro.props;
---

<Layout title={`Hinton Studios — ${title}`} description={brief}>
  <article class="bg-background pt-24 pb-32 min-h-screen">
    
    <!-- Hero Full Bleed Video -->
    <div class="relative w-full aspect-video bg-black/90">
      <iframe class="w-full h-full pointer-events-auto" src={`https://www.youtube.com/embed/${videoId}?autoplay=1&mute=1&loop=1&playlist=${videoId}&controls=1`} title={title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
      <div class="absolute inset-0 bg-gradient-to-t from-background via-transparent to-transparent pointer-events-none"></div>
    </div>

    <!-- Main Content -->
    <div class="max-w-6xl mx-auto px-6 md:px-12 mt-16 md:mt-24 grid grid-cols-1 md:grid-cols-12 gap-16">
      
      <!-- Metadata Sidebar -->
      <aside class="md:col-span-4" data-reveal>
        <h1 class="font-headline text-5xl md:text-7xl font-bold uppercase tracking-tighter text-primary leading-none mb-12">{title}</h1>
        
        <div class="space-y-6 border-l border-outline-variant/30 pl-6">
          <div>
            <span class="font-label text-[10px] text-tertiary uppercase tracking-widest block mb-1">GENRE</span>
            <span class="font-headline text-lg font-bold text-white uppercase">{metadata.genre}</span>
          </div>
          <div>
            <span class="font-label text-[10px] text-tertiary uppercase tracking-widest block mb-1">RUNTIME</span>
            <span class="font-headline text-lg font-bold text-white uppercase">{metadata.runtime}</span>
          </div>
          <div>
            <span class="font-label text-[10px] text-tertiary uppercase tracking-widest block mb-1">YEAR</span>
            <span class="font-headline text-lg font-bold text-white uppercase">{metadata.year}</span>
          </div>
          <div>
            <span class="font-label text-[10px] text-tertiary uppercase tracking-widest block mb-1">ROLE</span>
            <span class="font-headline text-lg font-bold text-white uppercase">{metadata.role}</span>
          </div>
          <div class="pt-6 border-t border-outline-variant/20">
            <span class="font-label text-[10px] text-tertiary uppercase tracking-widest block mb-3">THE STACK</span>
            <div class="flex flex-wrap gap-2">
              {metadata.tools.map(tool => (
                <span class="border border-outline-variant/40 bg-black/40 px-3 py-1 font-label text-[9px] uppercase tracking-widest text-[#c6c6c6] shadow-sm">{tool}</span>
              ))}
            </div>
          </div>
        </div>
      </aside>

      <!-- Description -->
      <div class="md:col-span-8 flex flex-col gap-12" data-reveal style="--reveal-delay: 100ms">
        <section>
          <span class="font-label text-[10px] text-outline uppercase tracking-[0.4em] block mb-4 border-b border-outline-variant/20 pb-2 inline-block">THE BRIEF</span>
          <p class="font-body text-lg text-on-surface-variant leading-relaxed">{brief}</p>
        </section>

        <section>
          <span class="font-label text-[10px] text-outline uppercase tracking-[0.4em] block mb-4 border-b border-outline-variant/20 pb-2 inline-block">THE APPROACH</span>
          <p class="font-body text-base text-on-surface leading-relaxed text-[#c6c6c6] bg-surface-container-low/50 p-6 border-l-2 border-primary/40">{approach}</p>
        </section>

        <!-- Behind the frame slot (optional) -->
        <slot name="behind-the-frame" />
      </div>
    </div>

    <!-- Hire CTA -->
    <div class="mt-32 max-w-4xl mx-auto px-6 text-center border-y border-outline-variant/10 py-24" data-reveal>
      <span class="font-label text-[10px] text-tertiary uppercase tracking-[0.5em] block mb-4">WANT THIS FOR YOUR BRAND?</span>
      <h3 class="font-headline text-3xl md:text-5xl font-bold text-white uppercase tracking-tighter mb-10">We can produce a similar masterpiece in days.</h3>
      <a href="/services#contact" class="inline-flex font-headline text-sm font-bold tracking-[0.3em] uppercase px-12 py-5 border-2 border-primary text-primary hover:bg-primary hover:text-black transition-colors duration-500">GET A QUOTE →</a>
    </div>

    <!-- Pagination -->
    <div class="max-w-6xl mx-auto px-6 md:px-12 mt-24">
      <div class="grid grid-cols-2 gap-4 border-t border-outline-variant/20 pt-8">
        <div>
          {prevSlug && (
            <a href={`/work/${prevSlug}`} class="group flex flex-col items-start hover:bg-surface-container-low p-4 transition-colors">
              <span class="font-label text-[10px] text-outline uppercase tracking-[0.3em] mb-2 group-hover:text-tertiary transition-colors">PREV /</span>
              <span class="font-headline text-xl md:text-2xl font-bold uppercase tracking-tighter">{prevTitle}</span>
            </a>
          )}
        </div>
        <div class="text-right">
          {nextSlug && (
            <a href={`/work/${nextSlug}`} class="group flex flex-col items-end hover:bg-surface-container-low p-4 transition-colors">
              <span class="font-label text-[10px] text-outline uppercase tracking-[0.3em] mb-2 group-hover:text-tertiary transition-colors">/ NEXT</span>
              <span class="font-headline text-xl md:text-2xl font-bold uppercase tracking-tighter">{nextTitle}</span>
            </a>
          )}
        </div>
      </div>
    </div>
  </article>
</Layout>
